# Copiez ce fichier en .env et renseignez vos valeurs. Ne le commitez jamais rempli.

# --- Base de données (obligatoire) ---
# Si le mot de passe contient des caractères spéciaux, encodez-les : * -> %2A, ! -> %21, @ -> %40, # -> %23
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@localhost:5434/gestionagro"

# --- Authentification (obligatoire) ---
# Générer avec : npx auth secret
AUTH_SECRET=""
# À mettre à "true" en production derrière un proxy (Coolify)
# AUTH_TRUST_HOST="true"

# --- Alertes par email (facultatif) ---
# Exemple Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, avec un « mot de passe d'application »
# (jamais votre mot de passe Gmail habituel). Voir DEPLOIEMENT.md.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Adresse publique de l'application (pour le lien dans les emails)
APP_URL=""
# Secret de la tâche planifiée qui envoie le résumé quotidien (16 caractères minimum)
CRON_SECRET=""

# --- Notifications push sur téléphone (facultatif) ---
# Générer les clés avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Une adresse de contact, au format mailto:
VAPID_SUBJECT="mailto:vous@exemple.com"
