generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GERANT
  MAGASINIER
  CAISSIER
  RESPONSABLE_PRODUCTION
}

enum StatutPiece {
  BROUILLON
  VALIDEE
  ANNULEE
}

enum StatutAchat {
  BROUILLON
  COMMANDE
  RECU_PARTIEL
  RECU
  ANNULE
}

enum ModePaiement {
  ESPECES
  ORANGE_MONEY
  MOOV_MONEY
  CREDIT
}

enum TypeMouvement {
  RECEPTION
  VENTE
  ANNULATION_VENTE
  PERTE
  TRANSFERT_ENTREE
  TRANSFERT_SORTIE
  INVENTAIRE
  PRODUCTION_ENTREE
  PRODUCTION_SORTIE
  AJUSTEMENT
  RETOUR_CLIENT
}

model User {
  id         String   @id @default(cuid())
  nom        String
  email      String   @unique
  motDePasse String
  role       Role
  actif      Boolean  @default(true)
  creeLe     DateTime @default(now())

  ventes  Vente[]
  journal JournalAction[]
}

model Depot {
  id      String  @id @default(cuid())
  nom     String  @unique
  adresse String?
  lots    Lot[]
}

model Categorie {
  id       String    @id @default(cuid())
  nom      String    @unique
  produits Produit[]
}

model Unite {
  id       String    @id @default(cuid())
  nom      String    @unique
  symbole  String
  produits Produit[]
}

model Produit {
  id          String   @id @default(cuid())
  code        String   @unique
  codeBarres  String?  @unique
  nom         String
  categorieId String
  uniteId     String
  prixAchat   Int      @default(0)
  prixVente   Int      @default(0)
  seuilAlerte Decimal  @default(0) @db.Decimal(14, 3)
  perissable  Boolean  @default(true)
  actif       Boolean  @default(true)
  creeLe      DateTime @default(now())

  categorie        Categorie         @relation(fields: [categorieId], references: [id])
  unite            Unite             @relation(fields: [uniteId], references: [id])
  conditionnements Conditionnement[]
  lots             Lot[]
  lignesAchat      LigneAchat[]
  lignesVente      LigneVente[]
  recettes         Recette[]
  lignesRecette    LigneRecette[]
}

model Conditionnement {
  id        String  @id @default(cuid())
  produitId String
  nom       String
  quantite  Decimal @db.Decimal(14, 3)
  prixVente Int?

  produit Produit @relation(fields: [produitId], references: [id])
}

model Fournisseur {
  id        String  @id @default(cuid())
  nom       String
  telephone String?
  adresse   String?
  achats    Achat[]
}

model Client {
  id            String               @id @default(cuid())
  nom           String
  telephone     String?
  plafondCredit Int                  @default(0)
  solde         Int                  @default(0)
  ventes        Vente[]
  encaissements EncaissementClient[]
}

model Achat {
  id              String      @id @default(cuid())
  numero          String      @unique
  fournisseurId   String
  statut          StatutAchat @default(BROUILLON)
  total           Int         @default(0)
  creeLe          DateTime    @default(now())
  creeParId       String?
  motifAnnulation String?
  annuleParId     String?

  fournisseur Fournisseur     @relation(fields: [fournisseurId], references: [id])
  lignes      LigneAchat[]
  paiements   PaiementAchat[]
}

model LigneAchat {
  id            String  @id @default(cuid())
  achatId       String
  produitId     String
  quantite      Decimal @db.Decimal(14, 3)
  quantiteRecue Decimal @default(0) @db.Decimal(14, 3)
  prixUnitaire  Int

  achat   Achat   @relation(fields: [achatId], references: [id])
  produit Produit @relation(fields: [produitId], references: [id])
}

model Lot {
  id               String    @id @default(cuid())
  produitId        String
  depotId          String
  numeroLot        String
  datePeremption   DateTime?
  quantiteInitiale Decimal   @db.Decimal(14, 3)
  quantiteRestante Decimal   @db.Decimal(14, 3)
  prixAchat        Int       @default(0)
  creeLe           DateTime  @default(now())

  produit       Produit                  @relation(fields: [produitId], references: [id])
  depot         Depot                    @relation(fields: [depotId], references: [id])
  mouvements    MouvementStock[]
  lignesVente   LigneVenteLot[]
  productions   Production[]
  consommations ConsommationProduction[]

  @@index([produitId, depotId, datePeremption])
}

model MouvementStock {
  id        String        @id @default(cuid())
  lotId     String
  type      TypeMouvement
  quantite  Decimal       @db.Decimal(14, 3) // + entrée, − sortie
  reference String?
  motif     String?
  auteurId  String?
  creeLe    DateTime      @default(now())

  lot Lot @relation(fields: [lotId], references: [id])
}

model Vente {
  id              String      @id @default(cuid())
  numero          String      @unique
  clientId        String?
  caissierId      String
  statut          StatutPiece @default(VALIDEE)
  total           Int
  remise          Int         @default(0)
  creeLe          DateTime    @default(now())
  motifAnnulation String?
  annuleeParId    String?

  client    Client?      @relation(fields: [clientId], references: [id])
  caissier  User         @relation(fields: [caissierId], references: [id])
  lignes    LigneVente[]
  paiements Paiement[]
  retours   Retour[]
}

model LigneVente {
  id           String  @id @default(cuid())
  venteId      String
  produitId    String
  quantite     Decimal @db.Decimal(14, 3)
  prixUnitaire Int
  remise       Int     @default(0)

  vente   Vente           @relation(fields: [venteId], references: [id])
  produit Produit         @relation(fields: [produitId], references: [id])
  lots    LigneVenteLot[]
  retours LigneRetour[]
}

model LigneVenteLot {
  id                String  @id @default(cuid())
  ligneVenteId      String
  lotId             String
  quantite          Decimal @db.Decimal(14, 3)
  quantiteRetournee Decimal @default(0) @db.Decimal(14, 3)

  ligneVente LigneVente @relation(fields: [ligneVenteId], references: [id])
  lot        Lot        @relation(fields: [lotId], references: [id])
}

model Paiement {
  id      String       @id @default(cuid())
  venteId String
  mode    ModePaiement
  montant Int

  vente Vente @relation(fields: [venteId], references: [id])
}

model Sequence {
  cle    String @id // ex. "FAC-2026"
  valeur Int    @default(0)
}

model JournalAction {
  id       String   @id @default(cuid())
  auteurId String
  action   String
  entite   String
  entiteId String?
  detail   Json?
  creeLe   DateTime @default(now())

  auteur User @relation(fields: [auteurId], references: [id])
}

model Recette {
  id               String   @id @default(cuid())
  nom              String   @unique
  produitFiniId    String
  quantiteProduite Decimal  @db.Decimal(14, 3) // quantité de produit fini obtenue pour 1 lot de recette
  actif            Boolean  @default(true)
  creeLe           DateTime @default(now())

  produitFini Produit        @relation(fields: [produitFiniId], references: [id])
  lignes      LigneRecette[]
  productions Production[]
}

model LigneRecette {
  id        String  @id @default(cuid())
  recetteId String
  produitId String
  quantite  Decimal @db.Decimal(14, 3) // matière première nécessaire pour 1 lot de recette

  recette Recette @relation(fields: [recetteId], references: [id])
  produit Produit @relation(fields: [produitId], references: [id])
}

model Production {
  id                String      @id @default(cuid())
  numero            String      @unique
  recetteId         String
  multiplicateur    Decimal     @db.Decimal(14, 3)
  quantiteTheorique Decimal     @db.Decimal(14, 3)
  quantiteObtenue   Decimal     @db.Decimal(14, 3)
  coutTotal         Int
  statut            StatutPiece @default(VALIDEE)
  lotId             String
  creeLe            DateTime    @default(now())
  creeParId         String
  motifAnnulation   String?
  annuleParId       String?

  recette       Recette                  @relation(fields: [recetteId], references: [id])
  lot           Lot                      @relation(fields: [lotId], references: [id])
  consommations ConsommationProduction[]
}

model ConsommationProduction {
  id           String  @id @default(cuid())
  productionId String
  lotId        String
  quantite     Decimal @db.Decimal(14, 3)

  production Production @relation(fields: [productionId], references: [id])
  lot        Lot        @relation(fields: [lotId], references: [id])
}

model EncaissementClient {
  id        String       @id @default(cuid())
  clientId  String
  montant   Int
  mode      ModePaiement
  note      String?
  creeParId String
  creeLe    DateTime     @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([creeLe])
}

model PaiementAchat {
  id        String       @id @default(cuid())
  achatId   String
  montant   Int
  mode      ModePaiement
  creeParId String
  creeLe    DateTime     @default(now())

  achat Achat @relation(fields: [achatId], references: [id])
}

model Depense {
  id              String       @id @default(cuid())
  categorie       String
  libelle         String
  montant         Int
  mode            ModePaiement
  dateDepense     DateTime
  statut          StatutPiece  @default(VALIDEE)
  creeParId       String
  creeLe          DateTime     @default(now())
  motifAnnulation String?
  annuleParId     String?

  @@index([dateDepense])
}

model Retour {
  id                String       @id @default(cuid())
  numero            String       @unique
  venteId           String
  motif             String
  total             Int
  modeRemboursement ModePaiement // CREDIT = déduit du solde du client
  remisEnStock      Boolean      @default(true)
  creeParId         String
  creeLe            DateTime     @default(now())

  vente  Vente         @relation(fields: [venteId], references: [id])
  lignes LigneRetour[]

  @@index([creeLe])
}

model LigneRetour {
  id           String  @id @default(cuid())
  retourId     String
  ligneVenteId String
  quantite     Decimal @db.Decimal(14, 3)
  montant      Int
  cout         Int     @default(0)

  retour     Retour     @relation(fields: [retourId], references: [id])
  ligneVente LigneVente @relation(fields: [ligneVenteId], references: [id])
}

model ClotureCaisse {
  id        String   @id @default(cuid())
  jour      DateTime @db.Date
  attendu   Int
  compte    Int
  ecart     Int
  note      String?
  creeParId String
  creeLe    DateTime @default(now())

  @@unique([jour, creeParId])
}

model TentativeConnexion {
  id      String   @id @default(cuid())
  email   String
  reussie Boolean
  creeLe  DateTime @default(now())

  @@index([email, creeLe])
}
